<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!--
    LineageOS 22.2 (Android 15) for Royna's Exynos7885 Samsung phones: A10, A20, A20e, A30,
    A30s and A40, built locally in a LineageOS 22.2 tree. Copy this file to
    .repo/local_manifests/exynos7885.xml. Uses LineageOS's own remote "github"
    (https://github.com) and its default branch (lineage-22.2), so the LineageOS projects
    below need no revision.
    Platform patches for this tree: patches/apply-patches.sh lineage-22.2.
  -->

  <!-- Common device, vendor, kernel -->
  <project path="device/samsung/exynos7885-common" name="Shaheddan/android_device_samsung_exynos7885-common" remote="github" revision="lineage-22.2" />
  <project path="vendor/samsung/exynos7885-common" name="Shaheddan/proprietary_vendor_samsung_exynos7885-common" remote="github" revision="lineage-22.2" />
  <project path="kernel/samsung/exynos7885" name="Shaheddan/android_kernel_samsung_exynos7885" remote="github" revision="android-15" clone-depth="1" />

  <!-- Devices -->
  <project path="device/samsung/a10" name="Shaheddan/android_device_samsung_a10" remote="github" revision="lineage-22.2" />
  <project path="device/samsung/a20" name="Shaheddan/android_device_samsung_a20" remote="github" revision="lineage-22.2" />
  <project path="device/samsung/a20e" name="Shaheddan/android_device_samsung_a20e" remote="github" revision="lineage-22.2" />
  <project path="device/samsung/a30" name="Shaheddan/android_device_samsung_a30" remote="github" revision="lineage-22.2" />
  <project path="device/samsung/a30s" name="Shaheddan/android_device_samsung_a30s" remote="github" revision="lineage-22.2" />
  <project path="device/samsung/a40" name="Shaheddan/android_device_samsung_a40" remote="github" revision="lineage-22.2" />
  <project path="vendor/samsung/a10" name="Shaheddan/proprietary_vendor_samsung_a10" remote="github" revision="lineage-22.2" />
  <project path="vendor/samsung/a20" name="Shaheddan/proprietary_vendor_samsung_a20" remote="github" revision="lineage-22.2" />
  <project path="vendor/samsung/a20e" name="Shaheddan/proprietary_vendor_samsung_a20e" remote="github" revision="lineage-22.2" />
  <project path="vendor/samsung/a30" name="Shaheddan/proprietary_vendor_samsung_a30" remote="github" revision="lineage-22.2" />
  <project path="vendor/samsung/a30s" name="Shaheddan/proprietary_vendor_samsung_a30s" remote="github" revision="lineage-22.2" />
  <project path="vendor/samsung/a40" name="Shaheddan/proprietary_vendor_samsung_a40" remote="github" revision="lineage-22.2" />

  <!-- LineageOS Samsung hardware (hardware/samsung/nfc is in LineageOS's own manifest) -->
  <project path="hardware/samsung" name="LineageOS/android_hardware_samsung" remote="github" />
  <project path="hardware/samsung_slsi/libbt" name="LineageOS/android_hardware_samsung_slsi_libbt" remote="github" />
  <project path="hardware/samsung_slsi/scsc_wifibt/wifi_hal" name="LineageOS/android_hardware_samsung_slsi_scsc_wifibt_wifi_hal" remote="github" />
  <project path="hardware/samsung_slsi/scsc_wifibt/wpa_supplicant_lib" name="LineageOS/android_hardware_samsung_slsi_scsc_wifibt_wpa_supplicant_lib" remote="github" />

  <!-- Exynos 7885 legacy userspace and sepolicy (Royna's, forked) -->
  <project path="hardware/samsung_slsi-linaro/graphics" name="Shaheddan/android_hardware_samsung_slsi-linaro_graphics" remote="github" revision="lineage-22.2" />
  <project path="hardware/samsung_slsi-linaro/exynos" name="Shaheddan/android_hardware_samsung_slsi-linaro_exynos" remote="github" revision="lineage-22.2" />
  <project path="hardware/samsung_slsi-linaro/config" name="Shaheddan/android_hardware_samsung_slsi-linaro_config" remote="github" revision="lineage-22.2" />
  <project path="hardware/samsung_slsi-linaro/openmax" name="Shaheddan/android_hardware_samsung_slsi-linaro_openmax" remote="github" revision="lineage-22.2" />
  <project path="device/samsung_slsi/sepolicy" name="Shaheddan/android_device_samsung_slsi_sepolicy" remote="github" revision="lineage-22.2" />
  <project path="hardware/samsung-ext/interfaces" name="Shaheddan/hardware_samsung-extra_interfaces" remote="github" revision="lineage-22.2" />

  <!-- IMS (VoLTE). Its rnnoise submodule comes through sync-s; the AEC3 commit it pins
       is not on any upstream branch, so it is fetched as its own project, as Royna does. -->
  <project path="packages/apps/PhhIms" name="krazey/ims" remote="github" revision="main" sync-s="true" />
  <project path="packages/apps/PhhIms/app/jni/webrtc-aec3" name="ewan-xu/AEC3" remote="github" revision="6b11f0f31cd10f6bf68025ccad771f545d87dbce" clone-depth="1" sync-s="true" />
</manifest>
