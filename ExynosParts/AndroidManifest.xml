<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.settings.exynos"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Performance restarts the phone to switch profiles. -->
    <uses-permission android:name="android.permission.REBOOT" />

    <!-- persistent: the bypass service has to be running to catch every plug-in. -->
    <application
        android:name=".ExynosPartsApp"
        android:label="@string/app_title"
        android:persistent="true"
        android:theme="@style/Theme.SubSettingsBase">

        <!-- Opened from Settings > Battery > Charging (a Settings patch adds the entry
             and hides the stock "Charging control" and "Charging speed" ones). -->
        <activity
            android:name=".ChargingActivity"
            android:label="@string/charging_title"
            android:exported="true">
            <intent-filter>
                <action android:name="org.lineageos.settings.action.DEVICE_CHARGING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Settings > System > Performance: listed on that page by Settings itself
             (IA_SETTINGS tile), with the active profile as its summary. -->
        <activity
            android:name=".PerformanceActivity"
            android:label="@string/perf_title"
            android:icon="@drawable/ic_settings_performance"
            android:theme="@style/Theme.Performance"
            android:enableOnBackInvokedCallback="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_settings_performance" />
            <meta-data
                android:name="com.android.settings.summary_uri"
                android:value="content://org.lineageos.settings.exynos.performance/getDynamicSummary/performance" />
        </activity>

        <!-- The same page in the app drawer; the switch on the page turns this off. -->
        <activity-alias
            android:name=".PerformanceLauncher"
            android:targetActivity=".PerformanceActivity"
            android:label="@string/perf_title"
            android:icon="@drawable/ic_performance"
            android:roundIcon="@drawable/ic_performance"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Settings > Network & internet > VoLTE (experimental), listed there by Settings
             itself (IA_SETTINGS tile). -->
        <activity
            android:name=".VolteActivity"
            android:label="@string/volte_title"
            android:icon="@drawable/ic_settings_volte"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.wireless" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_settings_volte" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/volte_tile_summary" />
        </activity>

        <provider
            android:name=".PerfSummaryProvider"
            android:authorities="org.lineageos.settings.exynos.performance"
            android:exported="true" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".BypassService"
            android:exported="false" />
    </application>
</manifest>
