    <!-- Page layout -->
    <string name="charging_intro">Choose how your phone charges: run it straight from the charger, stop at a level, or finish charging on a schedule.</string>
    <string name="charging_footer">Bypass charging and charge limits keep the battery cooler and away from a full charge, which slows battery wear. Normal charging always comes back when you unplug the charger.</string>
    <string name="charging_footer_no_bypass">Charge limits keep the battery away from a full charge, which slows battery wear. Normal charging always comes back when you unplug the charger.</string>
