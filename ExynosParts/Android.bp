// Settings > Battery > Charging (bypass charging, charging control and charging speed)
// and Settings > System > Performance (performance profiles) for the Exynos7885 Galaxy
// phones. Runs as system (platform key, android.uid.system) to write the charger node,
// use the hidden health API, set the profile property and restart the phone.
android_app {
    name: "ExynosParts",

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    static_libs: [
        "org.lineageos.platform.internal",
        "org.lineageos.settings.resources",
    ],

    required: ["privapp_allowlist_org.lineageos.settings.exynos"],
}

prebuilt_etc {
    name: "privapp_allowlist_org.lineageos.settings.exynos",
    src: "privapp_allowlist_org.lineageos.settings.exynos.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
