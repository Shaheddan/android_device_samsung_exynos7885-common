From 040dd0837348d8a6e559cd697ea6fcb53aeab4b4 Mon Sep 17 00:00:00 2001
From: shahed <jamshidalinezhadian@gmail.com>
Date: Sat, 14 Nov 2026 18:17:22 +0330
Subject: [PATCH 1/2] Settings: show the device's Charging page in Battery

The Exynos7885 Galaxy phones keep bypass charging, charging control and
charging speed together on one page in ExynosParts. Add an entry for it
under Battery when a device ships an activity for
org.lineageos.settings.action.DEVICE_CHARGING, and hide LineageParts'
charging control entry and the charging speed list in that case so they
don't show up twice.
---
 res/values/cm_strings.xml                     |  5 ++
 res/xml/power_usage_summary.xml               | 12 +++++
 .../ChargingSpeedPreferenceController.java    |  4 ++
 .../DeviceChargingPreferenceController.java   | 53 +++++++++++++++++++
 4 files changed, 74 insertions(+)
 create mode 100644 src/com/android/settings/fuelgauge/DeviceChargingPreferenceController.java

diff --git a/res/values/cm_strings.xml b/res/values/cm_strings.xml
index b3e7df2..d0ccf42 100644
--- a/res/values/cm_strings.xml
+++ b/res/values/cm_strings.xml
@@ -197,4 +197,9 @@
     <string name="battery_maximum_capacity">Maximum capacity</string>
     <string name="battery_maximum_capacity_summary">%1$d mAh (%2$d%%)</string>
     <string name="battery_maximum_capacity_not_available" translatable="false">@string/battery_cycle_count_not_available</string>
+
+    <!-- Device charging page (bypass, charging control and speed in one place) -->
+    <string name="device_charging_title">Charging</string>
+    <string name="device_charging_summary">Bypass charging, charge limit, schedules and speed</string>
+    <string name="device_charging_keywords">bypass, charging control, charge limit, charging speed, fast charging</string>
 </resources>
diff --git a/res/xml/power_usage_summary.xml b/res/xml/power_usage_summary.xml
index bf033cd..eb89d4a 100644
--- a/res/xml/power_usage_summary.xml
+++ b/res/xml/power_usage_summary.xml
@@ -64,6 +64,18 @@
         settings:controller="com.android.settings.fuelgauge.batterytip.BatteryManagerPreferenceController"
         settings:keywords="@string/keywords_battery_adaptive_preferences" />
 
+    <!-- Charging: bypass, charging control and charging speed on one page, provided by the
+         device (ExynosParts on the Exynos7885 Galaxy phones). When a device provides it,
+         the two stock entries below hide themselves. -->
+    <Preference
+        android:key="device_charging"
+        android:title="@string/device_charging_title"
+        android:summary="@string/device_charging_summary"
+        settings:keywords="@string/device_charging_keywords"
+        settings:controller="com.android.settings.fuelgauge.DeviceChargingPreferenceController">
+        <intent android:action="org.lineageos.settings.action.DEVICE_CHARGING" />
+    </Preference>
+
     <!-- Charging control -->
     <lineageos.preference.LineagePartsPreference
         android:key="charging_control"
diff --git a/src/com/android/settings/fuelgauge/ChargingSpeedPreferenceController.java b/src/com/android/settings/fuelgauge/ChargingSpeedPreferenceController.java
index a120ca6..ba181cb 100644
--- a/src/com/android/settings/fuelgauge/ChargingSpeedPreferenceController.java
+++ b/src/com/android/settings/fuelgauge/ChargingSpeedPreferenceController.java
@@ -82,6 +82,10 @@ public class ChargingSpeedPreferenceController extends BasePreferenceController
 
     @Override
     public int getAvailabilityStatus() {
+        // The device's own Charging page already contains charging speed.
+        if (DeviceChargingPreferenceController.isProvided(mContext)) {
+            return CONDITIONALLY_UNAVAILABLE;
+        }
         return mHealthInterface != null && mHealthInterface.isFastChargeSupported()
                 ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
     }
diff --git a/src/com/android/settings/fuelgauge/DeviceChargingPreferenceController.java b/src/com/android/settings/fuelgauge/DeviceChargingPreferenceController.java
new file mode 100644
index 0000000..5347a4c
--- /dev/null
+++ b/src/com/android/settings/fuelgauge/DeviceChargingPreferenceController.java
@@ -0,0 +1,53 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.fuelgauge;
+
+import android.content.Context;
+import android.content.Intent;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+
+import com.android.settings.core.BasePreferenceController;
+
+/**
+ * Shows the device's own Charging page (bypass charging, charging control and charging
+ * speed together) when the device ships one, and hides the stock charging control and
+ * charging speed entries in that case.
+ */
+public class DeviceChargingPreferenceController extends BasePreferenceController {
+
+    public static final String ACTION = "org.lineageos.settings.action.DEVICE_CHARGING";
+
+    // LineageParts' charging control entry on the same screen. It has no controller of its
+    // own here, so this one hides it when the device page covers charging control.
+    private static final String KEY_CHARGING_CONTROL = "charging_control";
+
+    public DeviceChargingPreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    /** Whether an installed app handles the device charging page. */
+    public static boolean isProvided(Context context) {
+        return new Intent(ACTION).resolveActivity(context.getPackageManager()) != null;
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return isProvided(mContext) ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public void displayPreference(PreferenceScreen screen) {
+        super.displayPreference(screen);
+        if (isProvided(mContext)) {
+            Preference chargingControl = screen.findPreference(KEY_CHARGING_CONTROL);
+            if (chargingControl != null) {
+                chargingControl.setVisible(false);
+            }
+        }
+    }
+}
