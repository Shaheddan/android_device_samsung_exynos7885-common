+    /**
+     * P-CSCF discovery for when the RIL put none in LinkProperties. Older Samsung RILs
+     * (Exynos7885 with a Shannon 327 modem, for one) never fill the data call's P-CSCF
+     * list and pass it only to Samsung's own IMS daemon, so we have to find it ourselves:
+     *  1. the ISIM's EF P-CSCF records (3GPP TS 31.103 4.2.8), where carriers can provision it
+     *  2. the 3GPP IMS domain (TS 23.003 13.2) looked up on the IMS network itself, since its
+     *     DNS servers are often only reachable over the IMS APN
+     *  3. the same names on the default network, as before
+     *  4. persist.ims.pcscf_fallback
+     */
+    fun discoverPcscf(
+        tag: String,
+        network: Network?,
+        mnc: String,
+        mcc: String,
+        isimPcscfs: List<String>,
+        ipVersionPolicy: SipIpVersionPolicy,
+    ): InetAddress? {
+        for (raw in isimPcscfs) {
+            val host = isimPcscfHost(raw) ?: continue
+            val addr = lookup(network, host, ipVersionPolicy) ?: lookup(null, host, ipVersionPolicy)
+            if (addr != null) {
+                Rlog.w(tag, "No P-CSCF from RIL, using the ISIM's $host: $addr")
+                return addr
+            }
+            Rlog.w(tag, "ISIM P-CSCF $host did not resolve")
+        }
+        val names = listOf(
+            "ims.mnc${mnc}.mcc${mcc}.pub.3gppnetwork.org",
+            "ims.mnc${mnc}.mcc${mcc}.3gppnetwork.org",
+        )
+        if (network != null) {
+            for (name in names) {
+                val addr = lookup(network, name, ipVersionPolicy) ?: continue
+                Rlog.w(tag, "No P-CSCF from RIL, $name on the IMS network: $addr")
+                return addr
+            }
+        }
+        for (name in names) {
+            val addr = lookup(null, name, ipVersionPolicy) ?: continue
+            Rlog.w(tag, "No P-CSCF from RIL, $name on the default network: $addr")
+            return addr
+        }
+        val prop = android.os.SystemProperties.get("persist.ims.pcscf_fallback", "")
+        if (prop.isNotEmpty()) {
+            val addr = lookup(network, prop, ipVersionPolicy) ?: lookup(null, prop, ipVersionPolicy)
+            if (addr != null) {
+                Rlog.w(tag, "No P-CSCF from RIL, using persist.ims.pcscf_fallback: $addr")
+                return addr
+            }
+        }
+        return null
+    }
+
+    /**
+     * An ISIM P-CSCF record is "<address type><address>" (00 FQDN, 01 IPv4, 02 IPv6) and
+     * reaches us as text, so only textual addresses are usable; anything else is skipped.
+     */
+    fun isimPcscfHost(raw: String?): String? {
+        if (raw.isNullOrEmpty()) return null
+        val body = if (raw[0].code in 0..2) raw.substring(1) else raw
+        val host = body.trim().trimEnd('\u0000')
+        return host.takeIf { it.isNotEmpty() && it.all { c -> c.code in 0x21..0x7e } }
+    }
+
+    private fun lookup(network: Network?, host: String, ipVersionPolicy: SipIpVersionPolicy): InetAddress? =
+        try {
+            val all = if (network != null) network.getAllByName(host) else InetAddress.getAllByName(host)
+            all.firstOrNull(ipVersionPolicy::accepts)
+        } catch (t: Throwable) {
+            null
+        }
+
     fun ratName(rat: Int): String =
         when (rat) {
             TelephonyManager.NETWORK_TYPE_LTE -> "LTE"
