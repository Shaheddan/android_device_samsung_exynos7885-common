+    /**
+     * P-CSCF addresses provisioned on the ISIM. TelephonyManager.getIsimPcscf() is hidden
+     * and needs READ_PRIVILEGED_PHONE_STATE, which this privileged app holds.
+     */
+    private fun readIsimPcscfs(): List<String> =
+        try {
+            (TelephonyManager::class.java.getMethod("getIsimPcscf").invoke(subTelephonyManager) as? Array<*>)
+                ?.filterIsInstance<String>()
+                .orEmpty()
+        } catch (t: Throwable) {
+            Rlog.d(TAG, "ISIM P-CSCF not readable: $t")
+            emptyList()
+        }
+
     private fun prepareImsEndpointForConnect(): Boolean {
         abandonnedBecauseOfNoPcscf = false
         resetRegistrationStateForConnect()
@@ -2109,6 +2123,8 @@ fun onWfcDisabled(reason: String) {
             mcc = mcc,
             preferredPcscf = preferredPcscf,
             ipVersionPolicy = carrierSettings.ipVersionPolicy,
+            network = network,
+            isimPcscfs = readIsimPcscfs(),
         )) {
             is ImsNetworkEndpointResolution.Success -> {
                 localAddr = endpoint.localAddr
