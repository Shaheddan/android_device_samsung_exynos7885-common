diff --git a/src/com/android/settings/fuelgauge/DeviceChargingPreferenceController.java b/src/com/android/settings/fuelgauge/DeviceChargingPreferenceController.java
new file mode 100644
index 0000000..aa9bab5
--- /dev/null
+++ b/src/com/android/settings/fuelgauge/DeviceChargingPreferenceController.java
@@ -0,0 +1,35 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.fuelgauge;
+
+import android.content.Context;
+import android.content.Intent;
+
+import com.android.settings.core.BasePreferenceController;
+
+/**
+ * Shows the device's own Charging page (bypass charging, charging control and charging
+ * speed together) when the device ships one, and lets the stock charging control and
+ * charging speed entries hide themselves in that case.
+ */
+public class DeviceChargingPreferenceController extends BasePreferenceController {
+
+    public static final String ACTION = "org.lineageos.settings.action.DEVICE_CHARGING";
+
+    public DeviceChargingPreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    /** Whether an installed app handles the device charging page. */
+    public static boolean isProvided(Context context) {
+        return new Intent(ACTION).resolveActivity(context.getPackageManager()) != null;
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return isProvided(mContext) ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+}
