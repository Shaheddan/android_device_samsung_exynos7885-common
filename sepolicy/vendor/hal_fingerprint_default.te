typeattribute hal_fingerprint_default data_between_core_and_vendor_violators;

allow hal_fingerprint_default self:netlink_socket { bind create write read };
allow hal_fingerprint_default uhid_device:chr_file rw_file_perms;

# Optical fingerprint illumination. Without the dir permissions below,
# glob("/sys/devices/platform/*/fingerprint_illum") cannot opendir the DECON
# platform directory, returns zero matches, and the HAL logs
# "fingerprint illum node: NOT FOUND" on every single call. The node exists and
# the pattern is correct - it is purely the missing allow. That is why the panel
# was never lit and the trustlet rejected every frame with BAD_QUALITY 39.
# Read-only on sysfs_decon, so this stays inside the r_fs_type neverallow.
allow hal_fingerprint_default sysfs_decon:dir { search getattr open read };

# The two writable attributes. These carry rw_fs_type (see public/file.te), which
# is what keeps the platform neverallow satisfied.
allow hal_fingerprint_default sysfs_fingerprint_illum:file rw_file_perms;
allow hal_fingerprint_default sysfs_lcd_writable:file rw_file_perms;

# Traverse to the mask level node. sesearch over the shipped
# precompiled_sepolicy (d4feaa7bc943725d415962d7555f533c) shows this domain
# had NO sysfs_lcd_writable:dir permission at all, while init,
# vendor_init, vold and hal_sensors_default all do. The file permission
# above is not sufficient: the containing directory is plain sysfs, and
# SELinux needs search on the target's own parent type to traverse into it.
# Without this the HAL logs
#   fingerprint illum level: open failed: Permission denied
#   fingerprint illum: open failed: Permission denied
# and no sensor target is ever lit, so enrollment cannot complete.
# Read-only traversal on purpose - nothing here needs create/rename.
allow hal_fingerprint_default sysfs_lcd_writable:dir { getattr ioctl lock open read search watch watch_reads };


# EFS calibration read. FPBAuthService::getCalibFromEFS (libbauthserver.so @
# 0x56384) does access("efs/biometrics/meta/egis_calibration_data.bin", F_OK)
# from cwd / and falls back to the same path under /efs. Stock policy grants
# this domain efs_file:dir {getattr search}, efs_file:file/lnk_file r_file_perms
# and sec_efs_file:dir/file/lnk_file - the Lineage base dropped every one of
# them, so under Enforcing the check fails with EACCES (strace, 2026-10-09,
# faccessat AT_FDCWD "efs/biometrics/meta/egis_calibration_data.bin"), the HAL
# logs the misleading "readCalibDataInEFS isn't exist" (it is a permission
# denial, not a missing file), rc=265, and getCalibFromEFS fails fatally:
# enrollment cannot complete after a /data format. Causal proof: a permissive
# A/B (fp_perm.sh) flipped only setenforce, the read then succeeded and
# storeMetaData self-healed calib.dat + egoptbds.dat into
# /data/vendor/biometrics/meta; Enforcing restored -> fails again.
# Read-only on purpose: the HAL never writes EFS (writeCALIBRATIONMetaData and
# writeCIDEFSMetaData target /data, already covered by
# biometrics_vendor_data_file; the blobs themselves are trustlet-written), and
# the /data self-heal write side needs no new rule.
allow hal_fingerprint_default efs_file:dir { getattr search };
allow hal_fingerprint_default efs_file:lnk_file r_file_perms;
allow hal_fingerprint_default efs_file:file r_file_perms;
allow hal_fingerprint_default sec_efs_file:dir { getattr search };
allow hal_fingerprint_default sec_efs_file:lnk_file r_file_perms;
allow hal_fingerprint_default sec_efs_file:file r_file_perms;
